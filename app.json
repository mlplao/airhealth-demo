{
    "expo": {
        "name": "AirHealth",
        "slug": "AirHealth",
        "version": "1.0.0",
        "orientation": "portrait",
        "scheme": "airhealth",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/airlogo.png",
                "backgroundColor": "#ffffff"
            },
            "edgeToEdgeEnabled": true,
            "package": "com.ua.airHealth",
            "versionCode": 2,

            "permissions": ["INTERNET", "ACCESS_FINE_LOCATION"],

            "config": {
                "googleMaps": {
                    "apiKey": "AIzaSyB83MnrMzIyIh1k-jNRm0GEKalWAE3XbUI"
                }
            }
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#ffffff"
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "6359378c-cd3d-4790-9d04-49a7be4855fd"
            }
        }
    }
}
